# Optional LLM narrative enrichment (PULSE runs fully deterministic without a key)
GROQ_API_KEY=
PULSE_GROQ_API_KEY=

# Deployment & Security Posture (defaults suit localhost research only)
PULSE_ENV=development
PULSE_HOST=127.0.0.1
PULSE_PORT=8000
PULSE_TRANSPORT_MODE=KAFKA
PULSE_REQUIRE_CONTROL_AUTH=false
# Set >= 16 char non-placeholder key (required whenever PULSE_ENV!=development, PULSE_HOST!=127.0.0.1, or PULSE_REQUIRE_CONTROL_AUTH=true):
PULSE_API_KEY=
PULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
PULSE_MAX_SSE_LISTENERS=64
